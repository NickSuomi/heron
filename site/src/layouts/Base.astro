---
import "@fontsource-variable/nunito-sans";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/heron/brand/assets/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/heron/brand/assets/social-preview.png" />
    <style>
      @import "../styles/tokens.css";

      * {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--heron-bg);
        color: var(--heron-text);
        font: 1.0625rem/1.6 var(--heron-font-sans);
        font-optical-sizing: auto;
      }
      a {
        color: var(--heron-link);
        text-decoration: none;
        text-underline-offset: 3px;
      }
      a:hover {
        text-decoration: underline;
      }
      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--heron-link);
        outline-offset: 2px;
      }
      :global(.wrap) {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 clamp(20px, 5vw, 48px);
      }
      :global(main) {
        display: flex;
        flex-direction: column;
        gap: 72px;
        padding-top: 72px;
        padding-bottom: 72px;
      }
      @media (min-width: 720px) {
        :global(main) {
          gap: 120px;
          padding-top: 120px;
          padding-bottom: 120px;
        }
      }
      :global(main section) {
        width: 100%;
        box-sizing: border-box;
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 clamp(20px, 5vw, 48px);
      }
      :global(main section.reveal) {
        opacity: 0;
        transform: translateY(12px);
        transition: opacity 0.6s ease, transform 0.6s ease;
      }
      :global(main section.reveal.in-view) {
        opacity: 1;
        transform: none;
      }
      :global(.section-grid) {
        display: grid;
        gap: 16px;
      }
      @media (min-width: 860px) {
        :global(.section-grid) {
          grid-template-columns: 200px minmax(0, 1fr);
          gap: 48px;
          align-items: start;
        }
      }
      :global(.section-label) {
        font-family: var(--heron-font-mono);
        font-size: var(--heron-size-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--heron-text-muted);
        padding-top: 0.2em;
      }
      :global(.section-body) {
        min-width: 0;
        max-width: 64ch;
      }
      :global(h1),
      :global(h2),
      :global(h3) {
        line-height: 1.15;
        font-weight: 700;
        letter-spacing: -0.01em;
      }
      :global(h2) {
        font-size: 1.375rem;
        margin: 0 0 1.25rem;
      }
      :global(p),
      :global(li) {
        color: var(--heron-text);
      }
      :global(p.muted) {
        color: var(--heron-text-muted);
        font-size: var(--heron-size-sm);
      }
      :global(code),
      :global(pre) {
        font-family: var(--heron-font-mono);
        font-size: 0.875rem;
      }
      :global(code) {
        background: var(--heron-code-bg);
        padding: 0.1em 0.4em;
        border-radius: 4px;
      }
      :global(pre) {
        background: var(--heron-code-bg);
        padding: 1rem 1.1rem;
        border-radius: 10px;
        overflow-x: auto;
        line-height: 1.6;
      }
      :global(pre code) {
        background: none;
        padding: 0;
      }
      :global(footer) {
        border-top: 1px solid var(--heron-border);
      }
      :global(footer .wrap) {
        padding: 2rem clamp(20px, 5vw, 48px);
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-wrap: wrap;
        color: var(--heron-text-muted);
        font-size: 0.875rem;
      }
      :global(footer img) {
        height: 22px;
        width: auto;
        opacity: 0.85;
      }
      :global(footer a) {
        color: var(--heron-text-muted);
      }
      :global(footer a:hover) {
        color: var(--heron-text);
      }
    </style>
  </head>
  <body>
    <slot />
    <script>
      const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (!prefersReduced && "IntersectionObserver" in window) {
        const sections = document.querySelectorAll("main section");
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("in-view");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15 },
        );
        // Mark sections as animated only once JS is confirmed running, so a
        // failed or slow script never leaves content invisible.
        sections.forEach((s) => {
          s.classList.add("reveal");
          io.observe(s);
        });
      }
    </script>
  </body>
</html>
