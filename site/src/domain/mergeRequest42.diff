+import { api } from "../api"
+import type { ProjectId } from "./types"
+
+const MAX = 20
+
+export const archiveSelected = async (
+  ids: ReadonlyArray<ProjectId>
+) => {
+  if (ids.length > MAX) {
+    throw new RangeError("max 20")
+  }
