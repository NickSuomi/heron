{
  "name": "heron-review",
  "private": true,
  "version": "0.0.0",
  "description": "Self-hosted code-review bot for GitLab merge requests",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NickSuomi/heron.git"
  },
  "homepage": "https://github.com/NickSuomi/heron#readme",
  "bugs": {
    "url": "https://github.com/NickSuomi/heron/issues"
  },
  "type": "module",
  "bin": {
    "heron": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "heron": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test",
    "gen-env-table": "node scripts/gen-env-table.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "ai": "7.0.106",
    "effect": "4.0.0-rc.115",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.115",
    "@types/node": "24.13.5",
    "markdown-it": "15.0.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
